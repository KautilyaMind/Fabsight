# Google Gemini Developer API (never commit real keys)
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# Existing GOOGLE_API_KEY is also supported when LLM_API_KEY is blank.
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_CHUNK_CHARS=3000
LLM_TIMEOUT_SECONDS=60
FAB_DB_PATH=data/database/fabsight.db
CHECKPOINT_DB_PATH=data/database/checkpoints.db
FABSIGHT_DATABASE_DIR=data/database
VECTOR_STORE_PATH=data/knowledge/processed
FABSIGHT_API_URL=http://localhost:8000
# Cloud container platforms normally set PORT automatically.
PORT=8000
VISION_REVIEW_THRESHOLD=0.60
RCA_REVIEW_THRESHOLD=0.55
REQUIRE_FINAL_APPROVAL=true
